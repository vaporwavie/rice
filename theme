#!/usr/bin/bash
# theme [auto|day|night|toggle|status]
# Renders the palette into every consumer (Hyprland, the Quickshell bar, Waybar, Fuzzel, Dunst, Hyprlock),
# reloads the ones that changed, and points GTK, Qt, and the portals at the matching scheme.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
gen="$here/generated"
mkdir -p "$gen"
prev=$(cat "$gen/current" 2>/dev/null || true)
scheduled=$("$here/daynight")
mode=${1:-auto}
case $mode in
    auto)
        # A manual pick holds until the schedule itself flips (next sunrise or sunset).
        mode=$scheduled
        if [[ -f $gen/override ]]; then
            read -r override_mode override_scheduled < "$gen/override"
            if [[ $override_scheduled == "$scheduled" ]]; then
                mode=$override_mode
            else
                rm -f "$gen/override"
            fi
        fi
        ;;
    day | night) echo "$mode $scheduled" > "$gen/override" ;;
    toggle)
        [[ $prev == night ]] && mode=day || mode=night
        echo "$mode $scheduled" > "$gen/override"
        ;;
    status) echo "${prev:-unset}"; exit 0 ;;
    *) echo "usage: theme [auto|day|night|toggle|status]" >&2; exit 2 ;;
esac

set -a
source "$here/themes/$mode.env"
set +a
vars="$(sed -n 's/^\([A-Z_]*\)=.*/${\1}/p' "$here/themes/$mode.env" | tr '\n' ' ') \${HOME}"

changed=()
render() {
    local name=$1 header=$2 out="$gen/$1" tmp
    tmp=$(mktemp "$gen/.$name.XXXXXX")
    { [[ -n $header ]] && printf '%s\n' "$header"; envsubst "$vars" < "$here/templates/$name.in"; } > "$tmp"
    if [[ -f $out ]] && cmp -s "$tmp" "$out"; then
        rm -f "$tmp"
        return
    fi
    mv "$tmp" "$out"
    changed+=("$name")
}
changed_has() {
    local x
    for x in "${changed[@]}"; do [[ $x == "$1" ]] && return 0; done
    return 1
}
has() { command -v "$1" >/dev/null 2>&1; }

render colors.lua "-- Generated by theme from templates/colors.lua.in"
render waybar-colors.css "/* Generated by theme from templates/waybar-colors.css.in */"
render fuzzel.ini "# Generated by theme from templates/fuzzel.ini.in"
render dunstrc "# Generated by theme from templates/dunstrc.in"
render hyprlock.conf "# Generated by theme from templates/hyprlock.conf.in"
render shell-colors.json ""
echo "$mode" > "$gen/current"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    if changed_has colors.lua; then hyprctl reload >/dev/null; fi
    if changed_has waybar-colors.css; then pkill -USR2 -x waybar || true; fi
    if changed_has shell-colors.json; then qs -p "$here/shell" ipc call theme reload >/dev/null 2>&1 || true; fi
    if changed_has dunstrc && has dunstctl; then dunstctl reload >/dev/null 2>&1 || true; fi
fi

wall="$here/$WALLPAPER"
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    if has swww && swww query >/dev/null 2>&1; then
        swww img "$wall" --transition-type fade --transition-duration 0.6 >/dev/null
    elif has swaybg && { [[ $prev != "$mode" ]] || ! pgrep -x swaybg >/dev/null; }; then
        pkill -x swaybg || true
        setsid swaybg -m fill -i "$wall" >/dev/null 2>&1 < /dev/null &
    fi
fi

gs=/usr/bin/gsettings
if [[ -x $gs ]]; then
    $gs set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME"
    $gs set org.gnome.desktop.interface gtk-theme "$GTK_THEME"
    $gs set org.gnome.desktop.interface icon-theme "$ICON_THEME"
    $gs set org.gnome.desktop.interface cursor-theme breeze_cursors
    $gs set org.gnome.desktop.interface font-name "Geist 10"
fi
for v in 3.0 4.0; do
    ini="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$v/settings.ini"
    [[ -f $ini ]] || continue
    sed -i \
        -e "s/^gtk-theme-name=.*/gtk-theme-name=$GTK_THEME/" \
        -e "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICON_THEME/" \
        -e "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$GTK_PREFER_DARK/" "$ini"
done
if has plasma-apply-colorscheme && has kreadconfig6 &&
    [[ $(kreadconfig6 --file kdeglobals --group General --key ColorScheme) != "$KDE_SCHEME" ]]; then
    plasma-apply-colorscheme "$KDE_SCHEME" >/dev/null 2>&1 || true
fi
