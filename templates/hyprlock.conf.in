general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
}

background {
    monitor =
    path = ${HOME}/.config/hypr/${WALLPAPER}
    color = rgb(${BG})
    brightness = ${LOCK_BRIGHTNESS}
    contrast = 1.05
}

label {
    monitor =
    text = $TIME
    font_family = Geist Light
    font_size = 112
    color = rgb(${FG})
    position = 0, 210
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %-d %B"
    font_family = Geist Mono
    font_size = 17
    color = rgb(${FG_DIM})
    position = 0, 118
    halign = center
    valign = center
}

shape {
    monitor =
    size = 440, 210
    color = rgba(${BG}f2)
    border_size = 2
    border_color = rgb(${ACCENT})
    rounding = 0
    position = 0, -60
    halign = center
    valign = center
}

label {
    monitor =
    text = $USER
    font_family = Geist Medium
    font_size = 16
    color = rgb(${FG})
    position = 0, 0
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 46
    position = 0, -60
    halign = center
    valign = center
    rounding = 0
    outline_thickness = 2
    outer_color = rgb(${BORDER})
    inner_color = rgb(${BG_ALT})
    font_color = rgb(${FG})
    font_family = Geist Mono
    check_color = rgb(${ACCENT})
    fail_color = rgb(${RED})
    capslock_color = rgb(${YELLOW})
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    fade_on_empty = false
    placeholder_text = <span foreground="##${MUTED}">password</span>
    fail_text =
}

label {
    monitor =
    text = $FAIL
    font_family = Geist Mono
    font_size = 12
    color = rgb(${RED})
    position = 0, -122
    halign = center
    valign = center
}

label {
    monitor =
    text = 󰌾  $LAYOUT
    font_family = JetBrainsMono Nerd Font
    font_size = 12
    color = rgb(${MUTED})
    position = -32, 28
    halign = right
    valign = bottom
}

label {
    monitor =
    text = cmd[] hostname
    font_family = Geist Mono
    font_size = 12
    color = rgb(${MUTED})
    position = 32, 28
    halign = left
    valign = bottom
}
