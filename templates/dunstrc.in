[global]
monitor = 0
follow = none
origin = top-right
offset = (14, 14)
width = (300, 400)
height = (0, 240)
gap_size = 8
corner_radius = 0
frame_width = 1
frame_color = "#${LINE_STRONG}"
separator_color = "#${BORDER}"
padding = 14
horizontal_padding = 16
text_icon_padding = 14
font = IBM Plex Sans 11
format = "<span font_weight='500'>%s</span>\n<span foreground='#${FG_DIM}'>%b</span>"
markup = full
alignment = left
vertical_alignment = center
line_height = 3
word_wrap = yes
ellipsize = end
show_age_threshold = 60
icon_position = left
min_icon_size = 20
max_icon_size = 32
icon_theme = ${ICON_THEME}, breeze, hicolor
enable_recursive_icon_lookup = true
progress_bar = true
progress_bar_height = 2
progress_bar_corner_radius = 0
progress_bar_frame_width = 0
highlight = "#${ACCENT}"
idle_threshold = 120
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current
dmenu = fuzzel --config=${HOME}/.config/hypr/generated/fuzzel.ini --dmenu --prompt "action "
layer = overlay

[urgency_low]
background = "#${BG_ALT}"
foreground = "#${MUTED}"
frame_color = "#${BORDER}"
timeout = 4

[urgency_normal]
background = "#${BG_ALT}"
foreground = "#${FG}"
timeout = 6

[urgency_critical]
background = "#${BG_ALT}"
foreground = "#${FG}"
frame_color = "#${RED}"
timeout = 0
