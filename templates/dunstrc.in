[global]
monitor = 0
follow = none
origin = top-right
offset = (10, 10)
width = (280, 380)
height = (0, 240)
gap_size = 6
corner_radius = 0
frame_width = 2
frame_color = "#${ACCENT}"
separator_color = frame
padding = 10
horizontal_padding = 12
text_icon_padding = 10
font = Geist Mono 11
format = "<b>%s</b>\n%b"
markup = full
alignment = left
vertical_alignment = center
line_height = 1
word_wrap = yes
ellipsize = end
show_age_threshold = 60
icon_position = left
min_icon_size = 20
max_icon_size = 32
icon_theme = ${ICON_THEME}, breeze, hicolor
enable_recursive_icon_lookup = true
progress_bar = true
progress_bar_height = 6
progress_bar_corner_radius = 0
progress_bar_frame_width = 0
highlight = "#${ACCENT}"
idle_threshold = 120
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current
layer = overlay

[urgency_low]
background = "#${BG}"
foreground = "#${MUTED}"
frame_color = "#${MUTED}"
timeout = 4

[urgency_normal]
background = "#${BG}"
foreground = "#${FG}"
timeout = 6

[urgency_critical]
background = "#${BG}"
foreground = "#${FG}"
frame_color = "#${RED}"
timeout = 0
